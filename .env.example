# Configuração opcional do Dip Scanner (ver docs/dip-scanner.md).
# Copie para .env para rodar localmente. Nenhuma chave de API é necessária.
# DIP_UNIVERSE=NVDA:SMH,TTD:IGV,AAPL
# DIP_MIN_DROP_PCT=5
# DIP_MIN_ATR_MULT=2.0
# DIP_MIN_VOLUME_RATIO=1.3
# DIP_MULTIDAY_DROP_PCT=10
# DIP_MAX_SIGNALS=8
# DIP_COOLDOWN_SESSIONS=5
# DIP_MARKET_DAY_PCT=2.5
