# Copie para .env para rodar localmente. No GitHub, cadastre em
# Settings -> Secrets and variables -> Actions (chaves = Secrets, o resto = Variables).

# ---- IA (Google Gemini) ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Notícias (opcional; sem chave usa as manchetes do Yahoo Finance) ----
TAVILY_API_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=

# ---- Dip Scanner (todas opcionais; ver docs/dip-scanner.md) ----
# DIP_UNIVERSE=NVDA:SMH,TTD:IGV,AAPL
# DIP_MIN_DROP_PCT=5
# DIP_MIN_ATR_MULT=2.0
# DIP_MIN_VOLUME_RATIO=1.3
# DIP_MULTIDAY_DROP_PCT=10
# DIP_MAX_SIGNALS=8
# DIP_COOLDOWN_SESSIONS=5
# DIP_MARKET_DAY_PCT=2.5
# DIP_OUTPUT_DIR=site
# DIP_REPORT_URL=
